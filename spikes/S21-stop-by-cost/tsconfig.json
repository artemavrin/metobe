{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "ai": ["./node_modules/ai"],
      "ai/test": ["./node_modules/ai/dist/test/index.d.ts"],
      "server-only": ["./stubs/server-only.ts"]
    }
  },
  "include": ["*.ts", "stubs/*.ts"]
}
