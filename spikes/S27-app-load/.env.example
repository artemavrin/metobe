# Copy to .env (git-ignored). Values come from apps/web/.env of the main checkout; the database is spike_s27 only.
DATABASE_URL=postgres://<user>:<password>@127.0.0.1:5432/spike_s27
# Logical database 9: the product's own Redis keys have no common prefix, so the spike keeps them apart (FLUSHDB at the end).
REDIS_URL=redis://127.0.0.1:6380/9
BETTER_AUTH_SECRET=<same as apps/web/.env>
BETTER_AUTH_URL=http://127.0.0.1:3427
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3427
SECRETS_KEY=<same as apps/web/.env>
