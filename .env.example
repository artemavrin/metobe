# Local development. install.sh generates a real .env for installations.
POSTGRES_PASSWORD=purr
DATABASE_URL=postgres://purr:purr@127.0.0.1:5432/purr
REDIS_URL=redis://127.0.0.1:6379
# install.sh generates this; for local dev: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Mailpit from the dev profile; leave empty to run without email login
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM="Purr <no-reply@purr.local>"

# Dev: bundled DB, host ports and Mailpit (compose.dev.yml)
COMPOSE_PROFILES=db
COMPOSE_FILE=docker/compose.yml:docker/compose.dev.yml
