# Local development. install.sh generates a real .env for installations.
POSTGRES_PASSWORD=metobe
DATABASE_URL=postgres://metobe:metobe@127.0.0.1:5432/metobe
REDIS_URL=redis://127.0.0.1:6379
# install.sh generates this; for local dev: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Mailpit from the dev profile: `pnpm --filter @metobe/cli cli mail:import-env` makes it the service's mail
# (/settings/mail), as the container does at its first start. Leave empty to set the mail up in the settings.
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM="Metobe <no-reply@metobe.local>"

# Bundled S3 (SeaweedFS, profile s3) on its host port; any secret will do locally
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=metobe
S3_ACCESS_KEY=metobe
S3_SECRET_KEY=metobe-dev-secret

# Dev: bundled DB and S3, host ports and Mailpit (compose.dev.yml)
COMPOSE_PROFILES=db,s3
COMPOSE_FILE=compose.yml:docker/compose.dev.yml
