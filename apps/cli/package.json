{
  "name": "@metobe/cli",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "start": "node --conditions=react-server dist/index.js",
    "cli": "tsx --conditions=react-server --env-file=../../.env src/index.ts"
  },
  "dependencies": {
    "@metobe/core": "workspace:*",
    "@metobe/db": "workspace:*",
    "@metobe/i18n": "workspace:*"
  },
  "devDependencies": {
    "@metobe/tsconfig": "workspace:*",
    "@types/node": "^20",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5"
  }
}
